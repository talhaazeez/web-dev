      "@type": "FAQPage",
      "@id": "https://sibe-cad.vercel.app/features/solidworks-bom-management/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can Sibe generate an indented BOM from a SolidWorks assembly?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sibe is designed to use managed assembly references and product structure as the starting point for an indented BOM workflow."
          }
        },
        {
          "@type": "Question",
          "name": "Can BOMs include SolidWorks custom properties?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Relevant properties such as part numbers, descriptions, materials, and project identifiers can be surfaced as product data for downstream workflows."
          }
        },
        {
          "@type": "Question",
          "name": "Can BOM information be exported for manufacturing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sibe’s product positioning includes structured exports for manufacturing. Confirm the current export format and plan capability for your specific process."
          }
        }
      ]
