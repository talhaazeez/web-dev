      "@type": "FAQPage",
      "@id": "https://sibe-cad.vercel.app/features/cad-file-management/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Does Sibe work with existing SolidWorks files?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sibe is designed to connect with existing SolidWorks projects through its native add-in so teams can evaluate the workflow on real files."
          }
        },
        {
          "@type": "Question",
          "name": "Can Sibe keep assembly references organized?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The workflow is built around related parts, drawings, and subassemblies rather than treating every CAD file as an isolated document."
          }
        },
        {
          "@type": "Question",
          "name": "Can non-CAD teammates search or review design data?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Teams can use browser-based collaboration and controlled sharing so non-CAD stakeholders can review selected product information without installing SolidWorks."
          }
        }
      ]
