    {
      "@type": "FAQPage",
      "@id": "https://sibe-cad.vercel.app/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How long does the Sibe free trial last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Sibe free trial lasts 14 days. Sibe currently promotes the trial as a no-credit-card evaluation with quick setup."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a credit card to sign up?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Sibe states that no credit card is required to start the 14-day trial."
          }
        },
        {
          "@type": "Question",
          "name": "Does Sibe require on-premise servers or a VPN?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Sibe is cloud-based, so customer-managed PDM servers are not required for the cloud setup, and remote access does not depend on a VPN."
          }
        },
        {
          "@type": "Question",
          "name": "Can I export the automatically generated BOM to Excel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sibe supports BOM management and file exports for downstream workflows. Confirm the exact export format and current plan capabilities for your specific manufacturing workflow."
          }
        },
        {
          "@type": "Question",
          "name": "Can non-CAD users access Sibe to review designs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Sibe supports browser-based 2D and 3D collaboration, allowing non-CAD stakeholders and external partners to review shared designs without needing a SolidWorks seat."
          }
        },
        {
          "@type": "Question",
          "name": "What is cloud CAD management for SolidWorks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cloud CAD management organizes SolidWorks files, references, versions, revisions, and collaboration in a shared online workspace instead of relying only on local folders or on-premise infrastructure."
          }
        },
        {
          "@type": "Question",
          "name": "How does SolidWorks version control prevent overwrites?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A check-in/check-out workflow makes the editing owner visible and helps prevent two engineers from changing the same file at the same time. Each check-in can create a new version with a record of the change."
          }
        },
        {
          "@type": "Question",
          "name": "Can suppliers review a SolidWorks design without SolidWorks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A secure browser-based review link can let external stakeholders inspect a shared 3D model or drawing without installing SolidWorks. Commenting and download controls depend on workspace permissions and plan settings."
          }
        }
      ]
    },
